# ---------------------------------------------------------------------------------------------
# Yalilai website — environment configuration. Copy to `.env.local` and fill in what you use.
# Never commit real secrets. Only variables prefixed NEXT_PUBLIC_ are exposed to browsers.
# ---------------------------------------------------------------------------------------------

# Public base URL (canonical links, sitemap, Open Graph). Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow search engines to index the site (keep false for previews).
ALLOW_INDEXING=false

# ---- Quote-request delivery (configure at least one; otherwise the form honestly reports
# ---- "not connected yet" and nothing is lost) ---------------------------------------------

# Where inquiries are sent (comma-separated for several recipients) and the sender address.
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Option A — Resend (https://resend.com): API key; the FROM domain must be verified there.
RESEND_API_KEY=

# Option B — any SMTP mailbox (e.g. Tencent Exmail / Alibaba Mail / Gmail Workspace).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Option C — webhook (Zapier, Make, n8n, Feishu/Lark, WeCom bots via a relay, your CRM…).
# Receives JSON incl. base64 attachments; signed with HMAC-SHA256 in X-Yalilai-Signature.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Local development only: write inquiries to ./.data/inquiries (ignored in production builds).
INQUIRY_DEV_STORE=0

# ---- Optional bot protection: Cloudflare Turnstile ----------------------------------------
# Note: Cloudflare challenges may load slowly for some visitors in mainland China.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
